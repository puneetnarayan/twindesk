     The full build only: notification access (the phone's notifications on the computer).
     The computer installs this build over the standard one through wireless debugging. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".NotifListener"
            android:exported="true"
            android:label="TwinDesk"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
